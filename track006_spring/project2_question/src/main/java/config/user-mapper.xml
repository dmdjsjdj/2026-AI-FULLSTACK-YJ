<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.the703.dao.UserMapper"> 
  <insert id="insert"  parameterType="UserDto" >
  	INSERT INTO users (nickname , bpass, email , mobile, bip) 
  	VALUES (#{nickname }, #{bpass}, #{email}, #{mobile}, #{bip});
  </insert>

  <select resultType="int" id="findLogin"  parameterType="UserDto">
  	select count(*) from users where email=#{email} and bpass=#{bpass};
  </select>
  
  <select resultType="UserDto" id="findByUno" parameterType="int">
    select       *  from users where uno=#{uno}
  </select>
  
  <select resultType="string" id="findByEmail"  parameterType="string" >
  	 select email  from users where email=#{email}
  </select>
  
  <select id="findByNickname"
          parameterType="string"
          resultType="UserDto">
     select *
     from users
     where nickname=#{nickname}
  </select>
  
  <select resultType="UserDto" id="findByEmailUserInfo"  parameterType="string" >
  	 select *  from users where email=#{email}
  </select>
  
  <!-- authorities -->
  <insert id="insertAuth"  parameterType="AuthDto">
  	insert into authorities (email, auth) values ( #{email}, #{auth})
  </insert>
  
  <select     resultMap="authListMap"   id="readAuth"  parameterType="string">
     select    u.email,  u.bpass,  a.auth
     from      users u    left   join authorities a    on u.email   = a.email  
     where     u.email =#{email} 
  </select>
  <resultMap  id="authListMap"          type="AuthUserDto">
       <result  property="email"         column="email"  />
       <result  property="bpass"         column="bpass"  />
       <collection  property="authList"  resultMap="authMap"  />
  </resultMap>
  <resultMap  id="authMap"       type="AuthDto" > 
       <result  property="auth"      column="auth"   />
  </resultMap>  
</mapper>
